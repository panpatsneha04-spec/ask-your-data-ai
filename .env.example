# AskYourData AI - database settings
#
# 1. Copy this file to a new file called .env  (in PowerShell: Copy-Item .env.example .env)
# 2. Fill in your real values in .env
# 3. NEVER commit .env - it is listed in .gitignore. This example file contains no secrets.

# --- MySQL connection -------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=askyourdata_demo
# Use a dedicated READ-ONLY account (see README: "Create a read-only MySQL user").
DB_USER=askyourdata_reader
# Leave empty to type the password in the app instead of storing it here.
DB_PASSWORD=

# --- Safety settings --------------------------------------------------------
# Comma-separated tables the app may read. Nothing is readable until you list
# tables here. "*" allows every table the database user can see (not recommended).
DB_ALLOWED_TABLES=sales
# Maximum rows returned by any query (1 - 10000).
DB_MAX_ROWS=500
# Stop queries that run longer than this many seconds (MySQL 5.7.8+ / MariaDB).
DB_QUERY_TIMEOUT_SECONDS=15
# Allow typing custom SELECT queries (true/false). The table browser and the
# query builder work either way.
DB_ALLOW_CUSTOM_SQL=true

# --- Optional: encrypted connection (e.g. cloud MySQL) ------------------------
# Path to the server's CA certificate file.
DB_SSL_CA=
